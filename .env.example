# Supabase est utilisé pour les fonctionnalités qui le nécessitent.
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<ANON_KEY>


# URL publique du frontend utilisée pour générer les QR codes.
VITE_PUBLIC_APP_URL=http://localhost:5173

# URL de base de l’API Support Connecté, avec le suffixe /api.
VITE_API_URL=http://localhost:4000/api
# (Le back-office /admin utilise cette même API ; sans cette variable, la base par défaut est /api.)
